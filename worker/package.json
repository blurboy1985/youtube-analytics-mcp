    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261110.1",
    "@types/node": "24.19.2",
    "esbuild": "0.25.12",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3"
  },
  "private": true
}
